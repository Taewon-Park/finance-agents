<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 2단계 페이퍼 트레이딩: 로그인·재부팅 때(RunAtLoad)와 1시간마다(StartInterval) swinglab paper run.
     배터리 상태이거나 처리할 거래일이 없으면 수집 없이 바로 끝나고, 그 기록은 paper/logs/skip.log에 날짜·사유별 한 줄로 남는다.
     전원이 연결된 첫 실행이 밀린 거래일을 순서대로 따라잡는다. 두 실행이 겹치면 뒤의 실행은 건너뛴다.
     경로는 main 체크아웃(/Users/taylor/Projects/finance-agents/swing-lab) 기준. 등록·해제는 swing-lab/README.md 참고. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swinglab.paper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/taylor/Projects/finance-agents/swing-lab &amp;&amp; /Users/taylor/.local/bin/uv run swinglab paper run --skip-log paper/logs/skip.log</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/taylor/Projects/finance-agents/swing-lab/paper/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/taylor/Projects/finance-agents/swing-lab/paper/logs/launchd.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
